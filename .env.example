# Cloudflare Worker secrets (never expose in Vite client code)
GROQ_API_KEY=replace-with-groq-key
# Upstash REST endpoint and token. REDIS_URL may include the token as the URL password.
REDIS_URL=https://your-upstash-endpoint.upstash.io
REDIS_TOKEN=replace-with-upstash-token
# Neon connection string for the execution service.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_API_TOKEN=replace-with-deploy-token
# Set the D1 database id in wrangler.toml after `wrangler d1 create forge-agent`
VITE_API_BASE_URL=http://localhost:8787
